# Copy to .env.local for local development. On Vercel, set each value in Project Settings → Environment Variables.

# MongoDB (same cluster/database as the platform; preferably a dedicated Atlas user for the back-office)
MONGODB_URI=

# Sign in with Google: OAuth client from Google Cloud Console (Web application).
# Authorized redirect URIs: https://<backoffice-domain>/api/auth/callback/google and http://localhost:3200/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only these Google accounts can sign in (comma separated).
BACKOFFICE_ALLOWED_EMAILS=lorenzopuppi815@gmail.com
# Session signing secret for the back-office (any long random string; NOT the platform's).
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3200

# Platform keys, only used to reveal or write encrypted fields (each reveal is audited).
WHATSAPP_TOKEN_ENCRYPTION_KEY=
AI_CREDENTIALS_ENCRYPTION_KEY=
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=
# CPF encryption: the platform's PII_ENCRYPTION_KEY, or its NEXTAUTH_SECRET if PII_ENCRYPTION_KEY is unset.
PLATFORM_PII_SECRET=

# Local development only (ignored by production builds): skip Google sign-in as this allowed email.
# BACKOFFICE_DEV_EMAIL=lorenzopuppi815@gmail.com
